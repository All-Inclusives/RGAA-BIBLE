{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rgaa-dataset.schema.json",
  "title": "AccessiGuide RGAA dataset",
  "type": "object",
  "$defs": {
    "pedagogicalTest": {
      "type": "object",
      "required": ["testId", "status", "plainLanguageDraft", "userBenefit", "cases"],
      "properties": {
        "testId": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": { "type": "string", "enum": ["draft", "inReview", "validated"] },
        "plainLanguageDraft": { "type": "string", "minLength": 1 },
        "userBenefit": { "type": "string", "minLength": 1 },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title", "context", "explanation", "resources", "code"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "context": { "type": "string", "minLength": 1 },
              "explanation": { "type": "string", "minLength": 1 },
              "visualEffect": { "type": "string", "enum": ["blur"] },
              "resources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "file", "altText", "source", "license"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "file": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
                    "altText": { "type": ["string", "null"] },
                    "source": { "type": "string", "minLength": 1 },
                    "license": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                }
              },
              "code": {
                "type": "object",
                "required": ["language", "snippet"],
                "properties": {
                  "language": { "type": "string", "minLength": 1 },
                  "snippet": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "source", "wcagVersion", "topics", "glossary", "methodologies", "counts"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.1.0"
    },
    "source": {
      "type": "object",
      "required": ["repository", "commit", "rgaaVersion", "license", "files"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "minLength": 40, "maxLength": 40 },
        "rgaaVersion": { "type": "string", "const": "4.1.2" },
        "license": { "type": "string" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "wcagVersion": {
      "type": "number"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "criteria"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9]+$" },
          "title": { "type": "string", "minLength": 1 },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "official", "editorial"],
              "properties": {
                "id": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
                "official": {
                  "type": "object",
                  "required": ["number", "title", "tests", "references"],
                  "properties": {
                    "number": { "type": "integer", "minimum": 1 },
                    "title": { "type": "string", "minLength": 1 },
                    "tests": {
                      "type": "object",
                      "minProperties": 1,
                      "additionalProperties": {
                        "oneOf": [
                          { "type": "string" },
                          {
                            "type": "array",
                            "items": { "type": "string" }
                          }
                        ]
                      }
                    },
                    "references": {
                      "type": "array",
                      "items": { "type": "object" }
                    }
                  },
                  "additionalProperties": true
                },
                "editorial": {
                  "type": "object",
                  "required": ["fr", "tags", "examples", "pedagogicalTests"],
                  "properties": {
                    "fr": {
                      "type": "object",
                      "required": ["explanation", "userImpact"],
                      "properties": {
                        "explanation": { "type": ["string", "null"] },
                        "userImpact": { "type": ["string", "null"] }
                      },
                      "additionalProperties": false
                    },
                    "tags": {
                      "type": "object",
                      "required": ["components", "disabilitySituations"],
                      "properties": {
                        "components": { "type": "array", "items": { "type": "string" } },
                        "disabilitySituations": { "type": "array", "items": { "type": "string" } }
                      },
                      "additionalProperties": false
                    },
                    "examples": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["language", "bad", "good"],
                        "properties": {
                          "language": { "type": "string" },
                          "bad": { "type": "string" },
                          "good": { "type": "string" }
                        },
                        "additionalProperties": false
                      }
                    },
                    "pedagogicalTests": {
                      "type": "array",
                      "items": { "$ref": "#/$defs/pedagogicalTest" }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "bodyHtml"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "bodyHtml": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "methodologies": {
      "type": "object",
      "propertyNames": { "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
      "additionalProperties": { "type": "string" }
    },
    "counts": {
      "type": "object",
      "required": ["topics", "criteria", "tests", "glossaryEntries", "methodologies"],
      "properties": {
        "topics": { "type": "integer", "minimum": 1 },
        "criteria": { "type": "integer", "minimum": 1 },
        "tests": { "type": "integer", "minimum": 1 },
        "glossaryEntries": { "type": "integer", "minimum": 1 },
        "methodologies": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
