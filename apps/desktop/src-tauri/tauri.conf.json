{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AccessiGuide",
  "version": "0.1.1",
  "identifier": "dev.accessiguide.rgaabible",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "AccessiGuide — RGAA",
        "width": 1240,
        "height": 900,
        "minWidth": 760,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA3ODgxNTU0Q0ZDRDM5MkUKUldRdU9jM1BWQldJQjVOZ2hpRlBLajV6dk9aV25VcGR0N3N2SmhGSGpOT1lMcEdlMFZJRlBnam8K",
      "endpoints": [
        "https://github.com/All-Inclusives/RGAA-BIBLE/releases/download/accessiguide-update-feed/latest.json"
      ]
    }
  }
}
